{
  // Solution file. The compiler options for each project live in the files
  // below; editor tooling uses these references to pick the right project for
  // a given file. `npm run typecheck` builds this solution with `tsc -b`, so
  // every referenced project is checked, and `tsconfig.electron.json` stays
  // outside it because that project emits a CommonJS build.
  // Keep this file free of `include`/`files` inputs: the referenced projects are
  // not composite, and `tsc -b` tolerates that only while the solution itself
  // has no inputs of its own.
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.tests.json" }
  ]
}
